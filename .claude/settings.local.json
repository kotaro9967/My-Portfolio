{
  "permissions": {
    "allow": [
      "PowerShell(npm run build 2>&1)",
      "PowerShell(Get-ChildItem -Path . -Filter \"SKILL.md\" -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch 'node_modules' })",
      "PowerShell(npm run dev)",
      "PowerShell(Get-Command chromium-cli -ErrorAction SilentlyContinue)",
      "PowerShell(npx playwright --version 2>&1)",
      "PowerShell(npx playwright install chromium --with-deps 2>&1)"
    ]
  }
}
